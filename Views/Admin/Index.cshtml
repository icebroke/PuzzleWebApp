@model PuzzleWebApp.ViewModels.AdminOverviewViewModel
@{
    ViewData["Title"] = "Keputusan keseluruhan";
    var accuracy = Model.TotalSubmittedAnswers == 0
        ? 0
        : (int)Math.Round((double)Model.TotalCorrectAnswers / Model.TotalSubmittedAnswers * 100);
}

<main class="admin-page">
    <header class="admin-header">
        <div>
            <p class="eyebrow">Pengurusan pentadbir</p>
            <h1>Keputusan keseluruhan</h1>
            <p class="admin-subtitle">@Model.CrosswordTitle</p>
            <p class="admin-subtitle">Kedudukan dikira daripada jumlah jawapan betul kedua-dua pusingan. Jika jumlah seri, nilai soalan kreativiti untuk menentukan tempat podium.</p>
        </div>
        <nav class="admin-header-actions" aria-label="Tindakan pentadbir">
            <a asp-action="Puzzles" class="btn btn-primary admin-manage-link">Urus teka silang kata</a>
            <form asp-action="Logout" method="post" data-ajax-form>
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary admin-logout" data-loading-text="Sedang log keluar…">
                    <span data-button-label>Log keluar</span>
                    <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
                </button>
            </form>
        </nav>
    </header>

    <section class="admin-stats" aria-label="Statistik keseluruhan">
        <article class="admin-stat-card"><span>Pemain</span><strong>@Model.TotalAttempts</strong><small>telah memulakan teka silang kata</small></article>
        <article class="admin-stat-card"><span>Lengkap</span><strong>@Model.SubmittedAttempts</strong><small>kedua-dua pusingan dihantar</small></article>
        <article class="admin-stat-card"><span>Jawapan betul</span><strong>@Model.TotalCorrectAnswers <small>/ @Model.TotalSubmittedAnswers</small></strong><small>untuk pemain yang melengkapkan kedua-dua pusingan</small></article>
        <article class="admin-stat-card"><span>Ketepatan keseluruhan</span><strong>@accuracy%</strong><small>jawapan yang dihantar sahaja</small></article>
    </section>

    <section class="admin-results-panel">
        <div class="admin-panel-heading">
            <div><span class="panel-kicker">Peserta</span><h2>Kedudukan dan keputusan pusingan</h2></div>
            <span class="clue-count">@Model.TotalFilteredAttempts</span>
        </div>
        <form asp-action="Index" method="get" class="admin-filter-form">
            <div class="admin-search-field">
                <label for="player-search">Cari pemain</label>
                <input id="player-search" name="q" type="search" value="@Model.SearchTerm" class="form-control" placeholder="Nama atau ID pemain" />
            </div>
            <div class="admin-status-field">
                <label for="status-filter">Status</label>
                <select id="status-filter" name="status" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">Semua pemain</option>
                    <option value="submitted" selected="@(Model.StatusFilter == "submitted")">Dihantar</option>
                    <option value="in-progress" selected="@(Model.StatusFilter == "in-progress")">Sedang bermain</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary admin-filter-button">Tapis</button>
        </form>
        @if (Model.Attempts.Count == 0)
        {
            <p class="admin-empty">@(Model.TotalAttempts == 0 ? "Belum ada pemain yang memulakan teka silang kata ini." : "Tiada pemain yang sepadan dengan carian ini.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-results-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Pemain</th>
                            <th scope="col">ID pemain</th>
                            <th scope="col">Tempat</th>
                            <th scope="col">Pusingan 1</th>
                            <th scope="col">Pusingan 2</th>
                            <th scope="col">Jumlah betul</th>
                            <th scope="col">Penilaian kreativiti</th>
                            <th scope="col">Semakan</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td class="admin-player-name" data-label="Pemain">@attempt.PlayerName</td>
                            <td data-label="ID pemain"><span class="admin-player-id">@attempt.PlayerId</span></td>
                            <td data-label="Tempat">
                                @if (attempt.OverallPlace.HasValue)
                                {
                                    <strong>@(attempt.OverallPlace.Value == 1 ? "Pemenang" : attempt.OverallPlace.Value == 2 ? "Tempat kedua" : attempt.OverallPlace.Value == 3 ? "Tempat ketiga" : $"#{attempt.OverallPlace.Value}")</strong>
                                }
                                else
                                {
                                    <span class="admin-score-total">@(attempt.IsComplete ? "Seri · perlu penilaian" : "Belum lengkap")</span>
                                }
                            </td>
                            <td data-label="Pusingan 1">
                                @if (attempt.RoundOneSubmitted)
                                {
                                    <strong>@attempt.RoundOneCorrectCount</strong><span class="admin-score-total"> / @attempt.RoundOneTotalClues</span>
                                }
                                else
                                {
                                    <span class="admin-score-total">@(attempt.RoundOneAttemptId.HasValue ? "Sedang bermain" : "Belum bermula")</span>
                                }
                            </td>
                            <td data-label="Pusingan 2">
                                @if (attempt.RoundTwoSubmitted)
                                {
                                    <strong>@attempt.RoundTwoCorrectCount</strong><span class="admin-score-total"> / @attempt.RoundTwoTotalClues</span>
                                }
                                else
                                {
                                    <span class="admin-score-total">@(attempt.RoundTwoAttemptId.HasValue ? "Sedang bermain" : "Belum bermula")</span>
                                }
                            </td>
                            <td data-label="Jumlah betul"><strong>@attempt.TotalCorrectCount</strong><span class="admin-score-total"> / @(attempt.RoundOneTotalClues + attempt.RoundTwoTotalClues)</span></td>
                            <td data-label="Penilaian kreativiti">
                                @if (attempt.IsTiedOnTotal && attempt.RoundTwoCreativeSubmitted && attempt.RoundTwoAttemptId.HasValue)
                                {
                                    <form asp-action="SetCreativeJudgmentPlace" method="post" class="creative-judgment-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="attemptId" value="@attempt.RoundTwoAttemptId.Value" />
                                        <input type="hidden" name="q" value="@Model.SearchTerm" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <input type="hidden" name="page" value="@Model.CurrentPage" />
                                        <select name="creativeJudgmentOrder" class="form-select" aria-label="Keutamaan penilaian kreativiti untuk @attempt.PlayerName">
                                            <option value="">Belum dinilai</option>
                                            @foreach (var order in attempt.CreativeJudgmentOptions)
                                            {
                                                <option value="@order" selected="@(attempt.CreativeJudgmentOrder == order)">Pilihan @order dalam seri</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-secondary">Simpan</button>
                                    </form>
                                }
                                else if (attempt.IsTiedOnTotal && !attempt.RoundTwoCreativeSubmitted)
                                {
                                    <span class="admin-score-total">Menunggu jawapan kreatif</span>
                                }
                                else if (!attempt.IsTiedOnTotal)
                                {
                                    <span class="admin-score-total">Tidak seri</span>
                                }
                                else
                                {
                                    <span class="admin-score-total">Menunggu pusingan 2</span>
                                }
                            </td>
                            <td data-label="Semakan" class="admin-round-review-links">
                                @if (attempt.RoundOneAttemptId.HasValue)
                                {
                                    <a asp-action="Attempt" asp-route-id="@attempt.RoundOneAttemptId.Value" class="admin-review-link">Semak pusingan 1 <span aria-hidden="true">→</span></a>
                                }
                                @if (attempt.RoundTwoAttemptId.HasValue)
                                {
                                    <a asp-action="Attempt" asp-route-id="@attempt.RoundTwoAttemptId.Value" class="admin-review-link">Semak pusingan 2 <span aria-hidden="true">→</span></a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <footer class="admin-list-footer">
                        <p>Memaparkan <strong>@Model.FirstItemNumber–@Model.LastItemNumber</strong> daripada <strong>@Model.TotalFilteredAttempts</strong> pemain</p>
                <nav class="admin-pagination" aria-label="Halaman keputusan pemain">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.CurrentPage - 1)" class="admin-page-control">Sebelumnya</a>
                    }
                    else
                    {
                        <span class="admin-page-control is-disabled" aria-disabled="true">Sebelumnya</span>
                    }
                    <span class="admin-page-number">@Model.CurrentPage / @Model.TotalPages</span>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.CurrentPage + 1)" class="admin-page-control">Seterusnya</a>
                    }
                    else
                    {
                        <span class="admin-page-control is-disabled" aria-disabled="true">Seterusnya</span>
                    }
                </nav>
            </footer>
        }
    </section>
</main>
