@model PuzzleWebApp.ViewModels.AdminLoginViewModel
@{
    ViewData["Title"] = "Log masuk pentadbir";
}

<main class="join-page">
    <section class="join-card admin-login-card">
        <div class="brand-mark" aria-hidden="true">⌑</div>
        <p class="eyebrow">Papan pemuka keputusan</p>
        <h1>Log masuk pentadbir</h1>
        <p class="intro">Semak penghantaran pemain dan periksa setiap jawapan.</p>

        @if (!Model.IsConfigured)
        {
            <div class="admin-config-notice" role="alert">
                Akses pentadbir belum dikonfigurasikan. Tetapkan pemboleh ubah persekitaran <code>Admin__AccessCode</code>, kemudian mulakan semula aplikasi.
            </div>
        }
        else
        {
            <form asp-action="Login" method="post" class="join-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="admin-login-error" role="alert">@Model.ErrorMessage</p>
                }
                <div class="mb-4">
                    <label asp-for="AccessCode" class="form-label">Kod akses pentadbir</label>
                    <input asp-for="AccessCode" type="password" class="form-control form-control-lg" autocomplete="current-password" autofocus />
                    <span asp-validation-for="AccessCode" class="field-validation"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Log masuk</button>
            </form>
        }
        <a asp-controller="Home" asp-action="Index" class="admin-back-link">← Kembali ke teka silang kata</a>
    </section>
</main>
