@model PuzzleWebApp.ViewModels.AdminLoginViewModel
@{
    ViewData["Title"] = "Log masuk pentadbir";
}

<main class="join-page">
    <section class="join-card admin-login-card">
        <img class="brand-mark mdht-logo" src="~/images/mdht-logo.png" alt="Majlis Daerah Hulu Terengganu" />
        <p class="eyebrow">Papan pemuka keputusan</p>
        <h1>Log masuk pentadbir</h1>
        <p class="intro">Semak penghantaran pemain dan periksa setiap jawapan.</p>

        @if (TempData["AdminPasswordChanged"] is not null)
        {
            <div class="admin-config-notice" role="alert">
                Kata laluan telah ditukar. Log masuk semula dengan kata laluan baharu.
            </div>
        }
        <form asp-action="Login" method="post" class="join-form" data-ajax-form>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="admin-login-error" role="alert">@Model.ErrorMessage</p>
            }
            <div class="mb-4">
                <label asp-for="Username" class="form-label">Nama pengguna</label>
                <input asp-for="Username" class="form-control form-control-lg" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Kata laluan</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>
            <p class="form-action-feedback" role="status" aria-live="polite" hidden></p>
            <button type="submit" class="btn btn-primary btn-lg w-100" data-loading-text="Sedang log masuk…">
                <span data-button-label>Log masuk</span>
                <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
            </button>
        </form>
        <a asp-controller="Home" asp-action="Index" class="admin-back-link">← Kembali ke teka silang kata</a>
    </section>
</main>
