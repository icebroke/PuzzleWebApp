@model PuzzleWebApp.ViewModels.AdminChangePasswordViewModel
@{
    ViewData["Title"] = "Tukar kata laluan pentadbir";
}

<main class="join-page">
    <section class="join-card admin-login-card">
        <p class="eyebrow">Keselamatan akaun</p>
        <h1>Tukar kata laluan</h1>
        <p class="intro">Reset kata laluan baharu sebelum meneruskan ke papan pemuka.</p>

        <form asp-action="ChangePassword" method="post" class="join-form" data-ajax-form>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="mb-4">
                <label asp-for="CurrentPassword" class="form-label">Kata laluan semasa</label>
                <input asp-for="CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label">Kata laluan baharu</label>
                <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Sahkan kata laluan baharu</label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>
            <p class="form-action-feedback" role="status" aria-live="polite" hidden></p>
            <button type="submit" class="btn btn-primary btn-lg w-100" data-loading-text="Menyimpan…">
                <span data-button-label>Simpan kata laluan</span>
                <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
            </button>
        </form>
    </section>
</main>