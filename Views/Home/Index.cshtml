@model PuzzleWebApp.ViewModels.CrosswordJoinViewModel
@{
    ViewData["Title"] = "Sertai teka silang kata";
}

<main class="join-page">
    <section class="join-card">
        <header class="join-welcome">
            <img class="brand-mark mdht-logo" src="~/images/mdht-logo.png" alt="Majlis Daerah Hulu Terengganu" />
            @if (Model.IsPuzzleAvailable)
            {
                <p class="eyebrow">Pusingan @Model.RoundNumber · Cabaran anda</p>
                <h1>@Model.CrosswordTitle</h1>
                <p class="intro">@Model.CrosswordDescription</p>
            }
            else
            {
                <h1>Teka silang kata belum dibuka</h1>
                <p class="intro">Permainan akan tersedia dalam tempoh yang ditetapkan oleh pentadbir.</p>
            }
        </header>

        @if (!Model.IsPuzzleAvailable)
        {
            <div class="join-unavailable">
                <p class="admin-notice" role="status">@Model.AvailabilityMessage</p>
                @if (Model.ScheduledStartAtMalaysia.HasValue && Model.ScheduledEndAtMalaysia.HasValue)
                {
                    <div class="join-note" role="note">
                        <strong>Jadual pusingan @Model.RoundNumber.</strong>
                        <span>Permainan dibuka dari <b>@Model.ScheduledStartAtMalaysia.Value.ToString("dd/MM/yyyy HH:mm")</b> hingga <b>@Model.ScheduledEndAtMalaysia.Value.ToString("dd/MM/yyyy HH:mm")</b>.</span>
                    </div>
                }
            </div>
        }
        else
        {
        <form asp-action="Join" method="post" class="join-form" data-ajax-form>
            @Html.AntiForgeryToken()
            <div class="join-form-heading">
                <span class="panel-kicker">Sedia untuk bermain?</span>
                <h2>Maklumat pemain</h2>
            </div>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="mb-3">
                <label asp-for="PlayerName" class="form-label"></label>
                <input asp-for="PlayerName" class="form-control form-control-lg" autocomplete="name" placeholder="Nama yang ingin digunakan" />
                <span asp-validation-for="PlayerName" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="PlayerId" class="form-label"></label>
                <input asp-for="PlayerId" class="form-control form-control-lg" autocomplete="off" placeholder="Masukkan MyKad anda" />
                <span asp-validation-for="PlayerId" class="field-validation"></span>
            </div>
            <p class="form-action-feedback" role="status" aria-live="polite" hidden></p>
            <button type="submit" class="btn btn-primary btn-lg w-100" data-loading-text="Sedang memulakan…">
                <span data-button-label>Mula bermain →</span>
                <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
            </button>
        </form>
        }

        <div class="join-support">
            @if (Model.IsPuzzleAvailable)
            {
                <div class="join-note" role="note">
                    <strong>Tempoh permainan · Pusingan @Model.RoundNumber</strong>
                    @if (Model.ScheduledStartAtMalaysia.HasValue && Model.ScheduledEndAtMalaysia.HasValue)
                    {
                        <span>Permainan dibuka dari <b>@Model.ScheduledStartAtMalaysia.Value.ToString("dd/MM/yyyy HH:mm")</b> hingga <b>@Model.ScheduledEndAtMalaysia.Value.ToString("dd/MM/yyyy HH:mm")</b>. Sila lengkapkan permainan sebelum waktu tutup.</span>
                    }
                    <span>Had masa teka silang kata: <b>@Model.TimeLimitMinutes minit</b>.</span>
                    @if (Model.RoundNumber == 2)
                    {
                        <span>Soalan kreativiti mempunyai had masa tambahan 10 minit selepas teka silang kata dihantar.</span>
                    }
                </div>
            }
            <div class="join-note">
                <strong>Nota</strong>
                <span>Anda boleh menyambung kuiz dengan log masuk semula menggunakan MyKad yang sama.</span>
            </div>
            <details class="join-terms">
                <summary>Syarat-syarat pertandingan</summary>
                <ol class="fw-bold">
                    <li>Terbuka kepada semua warga kerja MDHT.</li>
                    <li>Pertandingan dijalankan dalam 2 pusingan secara dalam talian.</li>
                    <li>Setiap peserta hanya dibenarkan menjawab sekali bagi setiap pusingan.</li>
                    <li>Markah kedua-dua pusingan akan dikumpulkan untuk menentukan pemenang keseluruhan dan keputusan adalah muktamad.</li>
                    <li>Peserta hendaklah mengisi maklumat diri dengan lengkap dan tepat.</li>
                </ol>
            </details>
        </div>

        <div class="join-footer">
            <p class="privacy-note">Data disimpan menggunakan MyKad pemain.</p>
            <a asp-controller="Admin" asp-action="Login" class="admin-entry-link">Pentadbir</a>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
