@model PuzzleWebApp.ViewModels.CrosswordJoinViewModel
@{
    ViewData["Title"] = "Sertai teka silang kata";
}

<main class="join-page">
    <section class="join-card">
        <div class="brand-mark" aria-hidden="true">✦</div> @* TODO: Change to MDHT logo *@
        <p class="eyebrow">Cabaran integriti ringkas</p>
        <p class="intro">@Model.CrosswordDescription</p>

        <div class="join-note">
            <strong>Nota:</strong>
            <span>Anda boleh menyambung kuiz dengan log masuk semula menggunakan MyKad yang sama.</span>
        </div>

        <div class="join-note">
            <strong>Syarat-Syarat Pertandingan:</strong>
            <span>1. Terbuka kepada semua warga kerja MDHT.</span>
            <span>2. Pertandinngan di jalankan dalam 2 pusingan secara dalam talian.</span>
            <span>3. Setiap peserta hanya dibenarkan jawab sekali bagi setiap pusingan.</span>
            <span>4. Markah kedua-dua pusingan akan dikumpulkan untuk menentukan pemenang keseluruhan & keputusan adalah muktamad.</span>
            <span>5. Peserta hendaklah mengisi maklumat diri dengan lengkap & tepat.</span>
        </div>

        <form asp-action="Join" method="post" class="join-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="mb-3">
                <label asp-for="PlayerName" class="form-label"></label>
                <input asp-for="PlayerName" class="form-control form-control-lg" autocomplete="name" placeholder="Nama yang ingin digunakan" />
                <span asp-validation-for="PlayerName" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="PlayerId" class="form-label"></label>
                <input asp-for="PlayerId" class="form-control form-control-lg" autocomplete="off" placeholder="Masukkan MyKad anda" />
                <span asp-validation-for="PlayerId" class="field-validation"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Mula bermain <span aria-hidden="true">→</span></button>
        </form>
        <div class="join-footer">
            <p class="privacy-note">Data disimpan menggunakan MyKad pemain.</p>
            <a asp-controller="Admin" asp-action="Login" class="admin-entry-link">Pentadbir</a>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
