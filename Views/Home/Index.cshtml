@model PuzzleWebApp.ViewModels.CrosswordJoinViewModel
@{
    ViewData["Title"] = "Sertai teka silang kata";
}

<main class="join-page">
    <section class="join-card">
        <div class="brand-mark" aria-hidden="true">✦</div>
        <p class="eyebrow">Cabaran integriti ringkas</p>
        <h1>@Model.CrosswordTitle</h1>
        <p class="intro">@Model.CrosswordDescription</p>

        <div class="join-note">
            <strong>Simpan kemajuan anda</strong>
            <span>Cipta ID pemain dan simpan dengan baik. Masukkan ID yang sama untuk menyambung permainan kemudian, walaupun menggunakan nama yang berbeza.</span>
        </div>

        <form asp-action="Join" method="post" class="join-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="mb-3">
                <label asp-for="PlayerName" class="form-label"></label>
                <input asp-for="PlayerName" class="form-control form-control-lg" autocomplete="name" placeholder="Nama yang ingin digunakan" />
                <span asp-validation-for="PlayerName" class="field-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="PlayerId" class="form-label"></label>
                <input asp-for="PlayerId" class="form-control form-control-lg" autocomplete="off" placeholder="Cipta atau masukkan ID pemain anda" />
                <span asp-validation-for="PlayerId" class="field-validation"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Mula bermain <span aria-hidden="true">→</span></button>
        </form>
        <div class="join-footer">
            <p class="privacy-note">Data anda disimpan menggunakan ID pemain.</p>
            <a asp-controller="Admin" asp-action="Login" class="admin-entry-link">Pentadbir</a>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
