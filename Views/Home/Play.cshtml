@model PuzzleWebApp.ViewModels.CrosswordPlayViewModel
@using PuzzleWebApp.Models
@{
    ViewData["Title"] = Model.CrosswordTitle;
    var orderedClues = Model.Clues.OrderBy(clue => clue.Number).ToList();
}

<main id="crossword-game" class="game-page" data-rows="@Model.Rows" data-columns="@Model.Columns" data-submitted="@Model.IsSubmitted.ToString().ToLowerInvariant()">
    <form id="antiforgery-form">@Html.AntiForgeryToken()</form>
    <header class="game-header">
        <a asp-action="Index" class="back-link" aria-label="Kembali ke halaman pemain">← <span>Keluar</span></a>
        <div class="game-heading">
            <p class="eyebrow">Cabaran integriti</p>
            <h1>@Model.CrosswordTitle</h1>
        </div>
        <div class="player-chip"><span class="player-avatar" aria-hidden="true">@Model.PlayerName[..1].ToUpperInvariant()</span><span>@Model.PlayerName</span></div>
    </header>

    <div class="game-intro">
        <p>@Model.CrosswordDescription</p>
        <div class="game-status" aria-live="polite">
            <span class="status-dot"></span>
            <span id="save-status">Data permainan disimpan secara automatik</span>
        </div>
    </div>

    @if (Model.IsSubmitted)
    {
        <div id="submission-banner" class="completion-banner" role="status">
            <span class="completion-icon" aria-hidden="true">✓</span>
            <div><strong>Jawapan anda telah dihantar.</strong><span>Terima kasih, @Model.PlayerName. Jawapan tidak boleh diubah lagi.</span></div>
        </div>
    }
    else
    {
        <div id="submission-banner" class="completion-banner d-none" role="status"></div>
    }

    <div class="game-view-switch" aria-label="Paparan permainan">
        <button type="button" class="is-active" data-game-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-game-view="clues" aria-pressed="false">Petunjuk <span>@Model.Clues.Count</span></button>
    </div>

    <style>
        #crossword-game .crossword-grid {
            --column-count: @Model.Columns;
            --row-count: @Model.Rows;
        }
    </style>

    <section class="game-layout" data-active-view="grid" aria-label="Crossword game">
        <div class="board-panel">
            <div class="board-toolbar">
                <div>
                    <span class="panel-kicker">Teka silang kata anda</span>
                    <span class="progress-label" id="progress-label">@Model.AnsweredCount daripada @Model.Clues.Count petunjuk dijawab</span>
                </div>
                <div class="puzzle-timer @(Model.TimeExpired ? "is-expired" : Model.IsSubmitted ? "is-stopped" : "")"
                     id="puzzle-timer"
                     data-remaining-seconds="@Model.RemainingSeconds"
                     data-running="@((!Model.IsSubmitted).ToString().ToLowerInvariant())"
                     role="timer"
                     aria-label="Masa keseluruhan teka silang kata">
                    <span class="puzzle-timer-label">@(Model.TimeExpired ? "Masa tamat" : Model.IsSubmitted ? "Jawapan dihantar" : $"Masa keseluruhan · {Model.TimeLimitMinutes} minit")</span>
                            <strong id="remaining-time">@(Model.IsSubmitted ? Model.TimeExpired ? "00:00" : "Selesai" : $"{Model.RemainingSeconds / 60:00}:{Model.RemainingSeconds % 60:00}")</strong>
                </div>
                <button type="button" class="direction-toggle" id="direction-toggle" aria-label="Tukar arah petunjuk">
                    <span class="direction-icon" aria-hidden="true">↔</span>
                    <span id="direction-label">Melintang</span>
                </button>
            </div>

            <div class="active-clue" aria-live="polite">
                <span>Petunjuk dipilih</span>
                <strong id="active-clue-text">Pilih petunjuk untuk bermula</strong>
                <span id="active-clue-meta"></span>
            </div>

            <div class="crossword-board-wrap">
                <div class="crossword-grid"
                     role="grid"
                     aria-label="Crossword letter grid">
                    @foreach (var cell in Model.Cells)
                    {
                        if (cell.IsPlayable)
                        {
                            <div class="crossword-square" data-row="@cell.Row" data-column="@cell.Column">
                                @if (cell.ClueNumber.HasValue)
                                {
                                    <span class="square-number">@cell.ClueNumber.Value</span>
                                }
                                <input class="crossword-cell"
                                       type="text"
                                       maxlength="1"
                                       value="@cell.Letter"
                                       autocomplete="off"
                                       autocapitalize="characters"
                                       spellcheck="false"
                                       inputmode="text"
                                       aria-label="Baris @(cell.Row + 1), lajur @(cell.Column + 1)"
                                       data-row="@cell.Row"
                                       data-column="@cell.Column"
                                       data-across-key="@cell.AcrossKey"
                                       data-down-key="@cell.DownKey"
                                       disabled="@Model.IsSubmitted" />
                            </div>
                        }
                        else
                        {
                            <div class="crossword-block" role="gridcell" aria-hidden="true"></div>
                        }
                    }
                </div>
            </div>
            <div class="board-actions">
                @if (!Model.IsSubmitted)
                {
                    <button type="button" class="btn btn-primary" id="submit-puzzle" data-loading-text="Sedang menghantar…">
                        <span data-button-label>Hantar jawapan</span>
                        <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="clear-answers" data-loading-text="Sedang mengosongkan…">
                        <span data-button-label>Kosongkan grid</span>
                        <span class="button-spinner" data-button-spinner aria-hidden="true" hidden></span>
                    </button>
                }
                else
                {
                    <span class="submitted-label">Telah dihantar</span>
                }
            </div>
            @if (!Model.IsSubmitted)
            {
                <p class="keyboard-hint">Klik/Tap petak untuk memilih petunjuk. Anda boleh membiarkan petunjuk lain kosong, tetapi mesti menjawab sekurang-kurangnya satu petunjuk dengan lengkap.</p>
                <p id="submission-feedback" class="submission-feedback" role="status" aria-live="polite"></p>
            }
        </div>

        <aside class="clues-panel" aria-label="Petunjuk teka silang kata">
            <div class="clues-heading">
                <div><span class="panel-kicker">Petunjuk</span><h2>Cari jawapannya</h2></div>
                <span class="clue-count">@Model.Clues.Count</span>
            </div>
            <ol class="clue-list">
                @for (var index = 0; index < orderedClues.Count; index++)
                {
                    var clue = orderedClues[index];
                    <li>
                        <button type="button"
                                class="clue-button"
                                data-clue-key="@clue.Key"
                                data-direction="@clue.Direction"
                                data-start-row="@clue.StartRow"
                                data-start-column="@clue.StartColumn"
                                data-length="@clue.Length"
                                aria-pressed="false">
                            <span class="clue-number">@(index + 1)</span>
                            <span class="clue-text">@clue.Text</span>
                            <span class="clue-length">@clue.Length huruf</span>
                            <span class="clue-check" aria-hidden="true">✓</span>
                        </button>
                    </li>
                }
            </ol>
        </aside>
    </section>

    @if (Model.IsRoundTwo && Model.IsSubmitted)
    {
        <section class="creative-panel" id="creative-question"
                 data-remaining-seconds="@Model.CreativeRemainingSeconds"
                 data-submitted="@Model.IsCreativeSubmitted.ToString().ToLowerInvariant()">
            <header class="creative-header">
                <div>
                    <span class="panel-kicker">Pusingan 2 · Bahagian B</span>
                    <h2>@Model.CreativeQuestionTitle</h2>
                </div>
                @if (!Model.IsCreativeSubmitted)
                {
                    <div class="puzzle-timer" id="creative-timer" role="timer" aria-label="Masa menjawab soalan kreativiti">
                        <span class="puzzle-timer-label">Masa menjawab · 10 minit</span>
                        <strong id="creative-remaining-time">@($"{Model.CreativeRemainingSeconds / 60:00}:{Model.CreativeRemainingSeconds % 60:00}")</strong>
                    </div>
                }
            </header>
            <p class="creative-question-text">@Model.CreativeQuestionText</p>
            <ul class="creative-guidance">
                @foreach (var guidance in Model.CreativeAnswerGuidance.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@guidance</li>
                }
            </ul>
            @if (Model.IsCreativeSubmitted)
            {
                <div class="completion-banner" role="status">
                    <span class="completion-icon" aria-hidden="true">✓</span>
                    <div><strong>@(Model.CreativeTimeExpired ? "Masa menjawab telah tamat." : "Jawapan kreativiti telah dihantar.")</strong><span>Jawapan anda tidak boleh diubah lagi.</span></div>
                </div>
                <div class="creative-answer-display">@Model.CreativeAnswer</div>
            }
            else
            {
                <label class="creative-answer-label" for="creative-answer">Pesanan anda</label>
                <textarea id="creative-answer" class="creative-answer-input" maxlength="5000" rows="7" aria-describedby="creative-save-status">@Model.CreativeAnswer</textarea>
                <div class="creative-actions">
                    <span id="creative-save-status" class="creative-save-status" role="status" aria-live="polite">Disimpan secara automatik</span>
                    <button type="button" class="btn btn-primary" id="submit-creative-answer">Hantar pesanan</button>
                </div>
                <p id="creative-feedback" class="submission-feedback" role="status" aria-live="polite"></p>
            }
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/crossword.js" asp-append-version="true" nonce="@Context.Items["ScriptNonce"]"></script>
}
