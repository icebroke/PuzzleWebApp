@model ErrorViewModel
@{
    ViewData["Title"] = "Ralat";
}

<main class="error-page">
    <section class="error-panel" role="alert">
        <p class="eyebrow">Ada sesuatu yang tidak kena</p>
        <h1>Ralat berlaku</h1>
        <p class="error-message">Permintaan anda tidak dapat diproses buat masa ini.</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id"><strong>ID permintaan:</strong> <code>@Model.RequestId</code></p>
        }

        <details class="error-details">
            <summary>Maklumat penyelesaian masalah</summary>
            <p>Persekitaran <strong>Development</strong> boleh memaparkan maklumat ralat yang lebih terperinci untuk penyahpepijatan setempat.</p>
            <p><strong>Jangan aktifkan persekitaran Development untuk aplikasi yang telah diterbitkan.</strong> Maklumat sensitif daripada pengecualian mungkin dipaparkan kepada pengguna.</p>
        </details>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Kembali ke teka silang kata</a>
    </section>
</main>
